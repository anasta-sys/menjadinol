.page {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 28px 24px 64px;
}

.hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28px;
  margin-bottom: 28px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 11px;
  margin: 0 0 8px;
  color: #9a7720;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .22em;
}

.eyebrowLine {
  width: 35px;
  height: 1px;
  background: #b99b4d;
}

.title {
  margin: 0;
  color: #0d4936;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(42px, 4vw, 56px);
  font-weight: 500;
  line-height: 1;
  letter-spacing: -.025em;
}

.intro {
  max-width: 670px;
  margin: 12px 0 0;
  color: #587065;
  font-size: 14px;
  line-height: 1.65;
}

.back {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 43px;
  padding: 0 20px;
  border: 1px solid rgba(27, 100, 67, .18);
  border-radius: 999px;
  background: rgba(255, 253, 245, .72);
  box-shadow: 0 8px 25px rgba(44, 67, 48, .05);
  color: #16563d;
  text-decoration: none;
  font-size: 12px;
  font-weight: 800;
  backdrop-filter: blur(12px);
  transition: transform .2s ease, box-shadow .2s ease;
}

.back:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(44, 67, 48, .10);
}

.libraryHead {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 19px;
}

.libraryKicker {
  margin: 0;
  color: #987619;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .22em;
}

.libraryTitle {
  margin: 5px 0 0;
  color: #103f31;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 27px;
  font-weight: 500;
  letter-spacing: -.015em;
}

.total {
  display: inline-flex;
  align-items: center;
  min-height: 34px;
  padding: 0 14px;
  border: 1px solid rgba(48, 101, 69, .15);
  border-radius: 999px;
  background: rgba(255, 255, 250, .70);
  color: #496454;
  font-size: 10px;
  font-weight: 850;
  backdrop-filter: blur(8px);
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 58px 20px;
  padding-top: 39px;
}

.card {
  --accent: #ca9200;
  --accent-dark: #a97900;
  --soft-a: rgba(255, 253, 245, .96);
  --soft-b: rgba(255, 244, 203, .88);

  position: relative;
  min-width: 0;
  min-height: 232px;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: visible;
  padding: 52px 24px 17px;
  border: 1px solid rgba(202, 146, 0, .78);
  border-radius: 32px;
  background:
    radial-gradient(
      circle at 50% -10%,
      rgba(255, 255, 255, .98) 0,
      rgba(255, 255, 255, .65) 31%,
      transparent 57%
    ),
    linear-gradient(145deg, var(--soft-a), var(--soft-b));
  box-shadow:
    0 17px 38px rgba(58, 72, 55, .09),
    0 3px 8px rgba(58, 72, 55, .035),
    inset 0 1px 0 rgba(255, 255, 255, .95);
  color: inherit;
  text-decoration: none;
  backdrop-filter: blur(12px);
  transition:
    transform .24s ease,
    box-shadow .24s ease,
    border-color .24s ease;
}

.green {
  --accent: #21835b;
  --accent-dark: #176b49;
  --soft-a: rgba(248, 255, 248, .96);
  --soft-b: rgba(214, 239, 216, .90);

  border-color: rgba(33, 131, 91, .72);
}

.card:hover {
  transform: translateY(-7px);
  box-shadow:
    0 24px 48px rgba(41, 69, 51, .14),
    0 5px 12px rgba(41, 69, 51, .05),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

.number {
  position: absolute;
  top: 17px;
  left: 19px;
  min-width: 29px;
  height: 29px;
  display: grid;
  place-items: center;
  padding: 0 8px;
  border-radius: 999px;
  background: var(--accent);
  box-shadow: 0 5px 13px rgba(61, 72, 48, .11);
  color: #fff;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .03em;
}

.icon {
  position: absolute;
  top: -39px;
  left: 50%;
  width: 78px;
  height: 78px;
  display: grid;
  place-items: center;
  transform: translateX(-50%);
  border: 1.5px solid var(--accent);
  border-radius: 50%;
  background:
    radial-gradient(
      circle at 40% 28%,
      #ffffff 0,
      #fffdf6 53%,
      #f7f1df 100%
    );
  color: var(--accent);
  box-shadow:
    0 12px 27px rgba(49, 69, 51, .12),
    0 0 0 7px rgba(255, 255, 255, .28);
  transition:
    transform .24s ease,
    box-shadow .24s ease;
}

.card:hover .icon {
  transform: translateX(-50%) translateY(-4px) scale(1.035);
  box-shadow:
    0 15px 31px rgba(49, 69, 51, .17),
    0 0 0 7px rgba(255, 255, 255, .34);
}

.copy {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.cardTitle {
  margin: 5px 0 0;
  color: #0c4b37;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 28px;
  font-weight: 500;
  line-height: 1.12;
  letter-spacing: -.02em;
}

.description {
  width: 100%;
  max-width: 280px;
  min-height: 36px;
  margin: 8px auto 8px;
  color: #587065;
  font-size: 12px;
  line-height: 1.55;
}

.folder {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 28px;
  padding: 0 12px;
  border: 1px solid rgba(54, 94, 66, .12);
  border-radius: 999px;
  background: rgba(255, 255, 255, .56);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7);
  color: #476051;
  font-size: 10px;
  font-weight: 850;
  backdrop-filter: blur(6px);
}

.folderIcon {
  color: var(--accent);
}

.action {
  width: 88%;
  min-height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13px;
  margin-top: 11px;
  padding: 0 18px;
  border-radius: 999px;
  background:
    linear-gradient(
      135deg,
      var(--accent),
      var(--accent-dark)
    );
  box-shadow:
    0 8px 18px rgba(66, 82, 58, .13),
    inset 0 1px 0 rgba(255, 255, 255, .20);
  color: #fff;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: .01em;
  transition:
    transform .2s ease,
    box-shadow .2s ease;
}

.card:hover .action {
  transform: translateY(-1px);
  box-shadow:
    0 11px 23px rgba(66, 82, 58, .18),
    inset 0 1px 0 rgba(255, 255, 255, .20);
}

.arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 19px;
  line-height: 1;
  transition: transform .18s ease;
}

.card:hover .arrow {
  transform: translateX(4px);
}

@media (max-width: 980px) {
  .grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 680px) {
  .page {
    padding: 27px 15px 54px;
  }

  .hero {
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .title {
    font-size: 39px;
  }

  .libraryHead {
    align-items: flex-start;
  }

  .libraryTitle {
    font-size: 23px;
  }

  .grid {
    grid-template-columns: 1fr;
    gap: 52px;
    padding-top: 39px;
  }

  .card {
    min-height: 245px;
  }
}
.card::after {
  content: "";
  position: absolute;
  top: 16px;
  right: 18px;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(255,255,255,.72) 0%,
    rgba(255,255,255,0) 70%
  );
  pointer-events: none;
}

.cardTitle::after {
  content: "";
  display: block;
  width: 24px;
  height: 1px;
  margin: 8px auto 0;
  background: var(--accent);
  opacity: .45;
}

@media (max-width: 680px) {
  .action {
    width: 92%;
  }
}
