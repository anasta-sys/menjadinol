.page {
  width: 100%;
  max-width: 1240px;
  margin: 0 auto;
  padding: 36px 24px 68px;
}

.hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28px;
  margin-bottom: 34px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0 0 8px;
  color: #927735;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .2em;
}

.eyebrowLine {
  width: 34px;
  height: 1px;
  background: #b5964d;
}

.title {
  margin: 0;
  color: #123f31;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(38px, 4vw, 52px);
  font-weight: 500;
  line-height: 1;
}

.intro {
  max-width: 650px;
  margin: 12px 0 0;
  color: #5f756a;
  font-size: 14px;
  line-height: 1.65;
}

.back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 42px;
  padding: 0 18px;
  border: 1px solid rgba(72, 112, 74, .25);
  border-radius: 999px;
  background: rgba(255, 253, 245, .82);
  color: #174f37;
  text-decoration: none;
  font-size: 12px;
  font-weight: 800;
  backdrop-filter: blur(8px);
}

.libraryHead {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 18px;
}

.libraryKicker {
  margin: 0;
  color: #8f773e;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .2em;
}

.libraryTitle {
  margin: 7px 0 0;
  color: #153f31;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 26px;
  font-weight: 500;
}

.total {
  display: inline-flex;
  align-items: center;
  min-height: 34px;
  padding: 0 13px;
  border: 1px solid rgba(91, 122, 80, .2);
  border-radius: 999px;
  background: rgba(250, 250, 241, .82);
  color: #536b58;
  font-size: 10px;
  font-weight: 800;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 58px 18px;
  padding-top: 42px;
}

.card {
  --accent: #c79311;
  --soft: rgba(255, 250, 232, .95);

  position: relative;
  min-width: 0;
  min-height: 310px;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 59px 25px 20px;
  border: 1.5px solid var(--accent);
  border-radius: 25px;
  background: linear-gradient(
    150deg,
    rgba(255, 255, 255, .95),
    var(--soft)
  );
  box-shadow:
    0 15px 36px rgba(51, 72, 55, .08),
    inset 0 1px 0 rgba(255, 255, 255, .95);
  color: inherit;
  text-decoration: none;
  backdrop-filter: blur(10px);
  transition:
    transform .2s ease,
    box-shadow .2s ease;
}

.green {
  --accent: #267b52;
  --soft: rgba(233, 247, 231, .95);
}

.card:hover {
  transform: translateY(-5px);
  box-shadow:
    0 21px 42px rgba(46, 70, 52, .14),
    inset 0 1px 0 rgba(255, 255, 255, .95);
}

.number {
  position: absolute;
  top: 15px;
  left: 17px;
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--accent);
  color: #fff;
  font-size: 10px;
  font-weight: 900;
}

.icon {
  position: absolute;
  top: -41px;
  left: 50%;
  width: 82px;
  height: 82px;
  display: grid;
  place-items: center;
  transform: translateX(-50%);
  border: 2px solid var(--accent);
  border-radius: 50%;
  background: #fffdf5;
  color: var(--accent);
  box-shadow: 0 9px 20px rgba(59, 73, 56, .12);
}

.copy {
  width: 100%;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.cardTitle {
  margin: 10px 0 0;
  color: #0e4634;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 27px;
  font-weight: 500;
  line-height: 1.15;
}

.description {
  max-width: 270px;
  min-height: 44px;
  margin: 12px auto 11px;
  color: #536b60;
  font-size: 12px;
  line-height: 1.55;
}

.folder {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 29px;
  padding: 0 11px;
  border: 1px solid rgba(75, 110, 72, .16);
  border-radius: 999px;
  background: rgba(255, 255, 255, .58);
  color: #496250;
  font-size: 10px;
  font-weight: 800;
}

.folderIcon {
  color: var(--accent);
}

.action {
  width: 100%;
  min-height: 43px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  margin-top: 18px;
  padding: 0 17px;
  border-radius: 999px;
  background: var(--accent);
  color: #fff;
  font-size: 11px;
  font-weight: 850;
  box-shadow: 0 8px 17px rgba(66, 82, 58, .11);
}

.arrow {
  font-size: 19px;
  line-height: 1;
  transition: transform .18s ease;
}

.card:hover .arrow {
  transform: translateX(3px);
}

@media (max-width: 980px) {
  .grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 680px) {
  .page {
    padding: 28px 15px 52px;
  }

  .hero {
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .title {
    font-size: 38px;
  }

  .libraryHead {
    align-items: flex-start;
  }

  .libraryTitle {
    font-size: 23px;
  }

  .grid {
    grid-template-columns: 1fr;
    gap: 58px;
    padding-top: 42px;
  }

  .card {
    min-height: 290px;
  }
}