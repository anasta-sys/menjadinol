.rt-admin-page {
  min-height: 100vh;
  padding: 34px;
  background:
    radial-gradient(circle at top right, rgba(188,177,122,.12), transparent 30%),
    #f3f1e8;
  color: #34483a;
}

.rt-admin-header {
  max-width: 1500px;
  margin: 0 auto 18px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.rt-admin-kicker {
  margin: 0 0 7px;
  color: #9b7c43;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .15em;
}

.rt-admin-header h1 {
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 34px;
  font-weight: 500;
}

.rt-admin-subtitle {
  margin: 7px 0 0;
  font-size: 13px;
  opacity: .62;
}

.rt-admin-dashboard-button {
  min-width: 180px;
  padding: 9px 15px 9px 10px;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 1px solid rgba(148,119,63,.22);
  border-radius: 16px;
  background: rgba(255,253,247,.88);
  box-shadow: 0 8px 24px rgba(64,78,66,.07);
  color: #35503d;
  text-decoration: none;
  transition: transform .18s ease, box-shadow .18s ease;
}

.rt-admin-dashboard-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 11px 28px rgba(64,78,66,.11);
}

.rt-admin-dashboard-mark {
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(168,132,65,.28);
  border-radius: 12px;
  background: #f3edda;
  color: #967638;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .05em;
}

.rt-admin-dashboard-button > span:last-child {
  display: flex;
  flex-direction: column;
  gap: 1px;
}

.rt-admin-dashboard-button small {
  font-size: 7px;
  font-weight: 700;
  letter-spacing: .12em;
  opacity: .48;
}

.rt-admin-dashboard-button strong {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 13px;
  font-weight: 500;
}

.rt-admin-stats {
  max-width: 1500px;
  margin: 0 auto 18px;
  display: grid;
  grid-template-columns: repeat(4, minmax(130px,1fr));
  gap: 12px;
}

.rt-admin-stats article {
  padding: 15px 17px;
  border: 1px solid rgba(70,91,76,.12);
  border-radius: 16px;
  background: rgba(255,255,255,.62);
}

.rt-admin-stats span {
  display: block;
  margin-bottom: 5px;
  font-size: 10px;
  opacity: .58;
}

.rt-admin-stats strong {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 24px;
  font-weight: 500;
}

.rt-admin-workspace {
  max-width: 1500px;
  min-height: 590px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 290px minmax(0,1fr);
  overflow: hidden;
  border: 1px solid rgba(70,91,76,.14);
  border-radius: 22px;
  background: rgba(255,255,255,.68);
  box-shadow: 0 18px 55px rgba(55,70,58,.08);
}

.rt-admin-sidebar {
  min-width: 0;
  border-right: 1px solid rgba(70,91,76,.11);
  background: rgba(248,246,237,.76);
}

.rt-admin-sidebar-head {
  padding: 17px;
  border-bottom: 1px solid rgba(70,91,76,.10);
}

.rt-admin-sidebar-title {
  margin-bottom: 11px;
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  letter-spacing: .08em;
}

.rt-admin-sidebar-head input {
  width: 100%;
  box-sizing: border-box;
  padding: 10px 12px;
  outline: none;
  border: 1px solid rgba(70,91,76,.15);
  border-radius: 999px;
  background: rgba(255,255,255,.76);
  color: inherit;
  font: inherit;
  font-size: 11px;
}

.rt-admin-user-list {
  padding: 8px;
}

.rt-admin-user {
  width: 100%;
  padding: 12px 10px;
  display: flex;
  align-items: center;
  gap: 10px;
  border: 0;
  border-bottom: 1px solid rgba(70,91,76,.07);
  border-radius: 12px;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.rt-admin-user:hover,
.rt-admin-user.is-active {
  background: rgba(116,142,119,.12);
}

.rt-admin-user-avatar {
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(148,119,63,.18);
  border-radius: 50%;
  background: #f4eddc;
  color: #92733c;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 15px;
}

.rt-admin-user-body {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.rt-admin-user-body strong {
  overflow: hidden;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 13px;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rt-admin-user-email {
  overflow: hidden;
  font-size: 9px;
  opacity: .57;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rt-admin-user-meta {
  font-size: 9px;
  color: #92743f;
}

.rt-admin-main {
  min-width: 0;
  display: flex;
  flex-direction: column;
  background: rgba(255,253,247,.62);
}

.rt-admin-conversation-head,
.rt-admin-thread-head {
  min-height: 78px;
  padding: 17px 20px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  border-bottom: 1px solid rgba(70,91,76,.10);
}

.rt-admin-thread-label {
  color: #9a7d47;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .12em;
}

.rt-admin-conversation-head h2,
.rt-admin-thread-head h2 {
  margin: 4px 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 20px;
  font-weight: 500;
}

.rt-admin-conversation-head p,
.rt-admin-thread-head p {
  margin: 0;
  font-size: 10px;
  opacity: .56;
}

.rt-admin-count-box {
  min-width: 72px;
  padding: 8px 13px;
  border: 1px solid rgba(70,91,76,.10);
  border-radius: 13px;
  background: rgba(255,255,255,.6);
  text-align: center;
}

.rt-admin-count-box strong,
.rt-admin-count-box span {
  display: block;
}

.rt-admin-count-box strong {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 19px;
  font-weight: 500;
}

.rt-admin-count-box span {
  margin-top: 1px;
  font-size: 8px;
  opacity: .52;
}

.rt-admin-conversation-area {
  padding: 17px 20px 20px;
}

.rt-admin-conversation-table-head {
  padding: 0 14px 8px 54px;
  display: grid;
  grid-template-columns: minmax(0,1fr) 80px 155px 55px;
  gap: 10px;
  color: #6d7b70;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.rt-admin-conversation-rows {
  border-top: 1px solid rgba(70,91,76,.08);
}

.rt-admin-conversation-row {
  width: 100%;
  min-height: 59px;
  padding: 8px 14px;
  display: grid;
  grid-template-columns: 30px minmax(0,1fr) 80px 155px 55px;
  align-items: center;
  gap: 10px;
  border: 0;
  border-bottom: 1px solid rgba(70,91,76,.08);
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.rt-admin-conversation-row:hover {
  background: rgba(116,142,119,.075);
}

.rt-admin-conversation-number {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 11px;
  color: #a28349;
}

.rt-admin-conversation-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.rt-admin-conversation-info strong {
  overflow: hidden;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 13px;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rt-admin-conversation-info small {
  width: fit-content;
  padding: 2px 6px;
  border-radius: 999px;
  background: rgba(116,142,119,.10);
  font-size: 7px;
  text-transform: uppercase;
  opacity: .7;
}

.rt-admin-conversation-message-count,
.rt-admin-conversation-date {
  font-size: 9px;
  opacity: .62;
}

.rt-admin-open {
  color: #8d713d;
  font-size: 9px;
  font-weight: 700;
  text-align: right;
}

.rt-admin-pagination-wrap {
  min-height: 54px;
  padding-top: 14px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.rt-admin-page-info {
  font-size: 9px;
  opacity: .52;
}

.rt-admin-pagination {
  display: flex;
  align-items: center;
  gap: 5px;
}

.rt-admin-pagination button {
  min-width: 30px;
  height: 30px;
  padding: 0 8px;
  border: 1px solid rgba(70,91,76,.14);
  border-radius: 9px;
  background: rgba(255,255,255,.68);
  color: #455d4c;
  font: inherit;
  font-size: 10px;
  cursor: pointer;
}

.rt-admin-pagination button:hover:not(:disabled),
.rt-admin-pagination button.is-active {
  border-color: #b59a65;
  background: #e9e3d2;
  color: #6f572d;
}

.rt-admin-pagination button.is-active {
  font-weight: 800;
}

.rt-admin-pagination button:disabled {
  cursor: default;
  opacity: .28;
}

.rt-admin-back-list {
  margin-bottom: 7px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #8d713d;
  font: inherit;
  font-size: 9px;
  font-weight: 700;
  cursor: pointer;
}

.rt-admin-thread-title {
  min-width: 0;
}

.rt-admin-thread-status {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}

.rt-admin-thread-status span {
  padding: 5px 9px;
  border-radius: 999px;
  background: rgba(115,143,118,.12);
  font-size: 9px;
  text-transform: uppercase;
}

.rt-admin-thread-status small {
  font-size: 9px;
  opacity: .52;
}

.rt-admin-messages {
  flex: 1;
  min-height: 430px;
  max-height: 650px;
  overflow-y: auto;
  padding: 22px;
}

.rt-admin-message {
  max-width: 78%;
  margin-bottom: 16px;
  padding: 14px 16px;
  border: 1px solid rgba(70,91,76,.10);
  border-radius: 17px;
}

.rt-admin-message-user {
  margin-left: auto;
  background: rgba(125,151,128,.14);
  border-bottom-right-radius: 5px;
}

.rt-admin-message-ai {
  margin-right: auto;
  background: rgba(255,255,255,.80);
  border-bottom-left-radius: 5px;
}

.rt-admin-message-head {
  margin-bottom: 8px;
  display: flex;
  justify-content: space-between;
  gap: 14px;
  font-size: 9px;
}

.rt-admin-message-head strong {
  color: #55705c;
}

.rt-admin-message-head time {
  opacity: .48;
}

.rt-admin-message-content {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-size: 12px;
  line-height: 1.65;
}

.rt-admin-flags {
  margin-top: 9px;
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.rt-admin-flags span {
  padding: 4px 7px;
  border-radius: 999px;
  background: rgba(166,133,72,.10);
  color: #846b3e;
  font-size: 8px;
  font-weight: 700;
}

.rt-admin-sources {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid rgba(70,91,76,.09);
}

.rt-admin-sources small {
  display: block;
  margin-bottom: 6px;
  font-size: 9px;
  font-weight: 700;
  opacity: .58;
}

.rt-admin-sources > div {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.rt-admin-sources a,
.rt-admin-sources > div > span {
  padding: 5px 8px;
  border: 1px solid rgba(70,91,76,.12);
  border-radius: 999px;
  background: rgba(248,246,237,.8);
  color: #526c58;
  font-size: 9px;
  text-decoration: none;
}

.rt-admin-readonly {
  padding: 10px 18px;
  border-top: 1px solid rgba(70,91,76,.09);
  font-size: 9px;
  text-align: center;
  opacity: .48;
}

.rt-admin-empty,
.rt-admin-no-thread {
  padding: 30px 20px;
  font-size: 11px;
  line-height: 1.6;
  text-align: center;
  opacity: .6;
}

.rt-admin-no-thread {
  margin: auto;
}

.rt-admin-no-thread strong {
  display: block;
  margin-bottom: 5px;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 17px;
}

.rt-admin-no-thread p {
  margin: 0;
}

@media (max-width: 900px) {
  .rt-admin-page {
    padding: 20px 14px;
  }

  .rt-admin-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .rt-admin-stats {
    grid-template-columns: repeat(2,1fr);
  }

  .rt-admin-workspace {
    grid-template-columns: 1fr;
  }

  .rt-admin-sidebar {
    border-right: 0;
    border-bottom: 1px solid rgba(70,91,76,.11);
  }

  .rt-admin-user-list {
    max-height: 260px;
    overflow-y: auto;
  }

  .rt-admin-conversation-table-head {
    display: none;
  }

  .rt-admin-conversation-row {
    grid-template-columns: 30px minmax(0,1fr) 50px;
  }

  .rt-admin-conversation-message-count,
  .rt-admin-conversation-date {
    display: none;
  }

  .rt-admin-pagination-wrap {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 560px) {
  .rt-admin-header h1 {
    font-size: 28px;
  }

  .rt-admin-dashboard-button {
    width: 100%;
    box-sizing: border-box;
  }

  .rt-admin-message {
    max-width: 92%;
  }

  .rt-admin-conversation-head,
  .rt-admin-thread-head {
    align-items: flex-start;
    flex-direction: column;
  }

  .rt-admin-thread-status {
    align-items: flex-start;
  }
}