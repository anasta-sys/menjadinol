.rc-widget,
.rc-widget * {
  box-sizing: border-box;
}

.rc-widget {
  --cream: #fffaf0;
  --paper: #fffdf7;
  --green: #245b3d;
  --green2: #47764d;
  --sage: #819d70;
  --gold: #d3a13d;
  --muted: #78827a;

  position: fixed;
  z-index: 2147483000;
  right: 120px;
  bottom: 24px;

  font-family: Aptos, "Segoe UI", Arial, sans-serif;
  color: var(--green);
}

/* =========================================================
   FLOATING LAUNCHER
========================================================= */

.rc-launch-area {
  position: relative;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.rc-launch {
  position: relative;

  width: 64px;
  height: 64px;
  padding: 0;

  display: grid;
  place-items: center;

  overflow: visible;

  border: 2px solid #d4aa54;
  border-radius: 50%;

  background: #fffaf0;

  box-shadow:
    0 12px 30px rgba(38,75,48,.18),
    0 0 0 5px rgba(255,250,240,.76);

  cursor: pointer;

  transition: transform .18s ease;
}

.rc-launch:hover {
  transform: translateY(-3px) scale(1.035);
}

.rc-launch-label {
  position: absolute;
  right: 77px;

  width: auto;
  min-width: 108px;
  padding: 9px 16px;

  border: 1px solid rgba(48,83,55,.12);
  border-radius: 999px;

  background: rgba(255,250,240,.97);

  color: #315f43;

  box-shadow: 0 8px 24px rgba(42,70,48,.11);

  font-family: Aptos, "Segoe UI", Arial, sans-serif;
  font-size: 13px;
  font-weight: 500;
  line-height: 1;

  white-space: nowrap;

  opacity: 0;
  visibility: hidden;
  transform: translateX(7px);

  transition: .16s ease;

  pointer-events: none;
}

.rc-launch-area:hover .rc-launch-label {
  opacity: 1;
  visibility: visible;
  transform: translateX(0);
}

.rc-story-symbol {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
}

.rc-story-symbol-inner {
  position: absolute;
  inset: 4px;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  border: 2px solid #658252;
  border-radius: 50%;

  background: #fffaf0;
}

.rc-story-logo {
  width: 78%;
  height: 78%;
  object-fit: contain;
}

.rc-story-leaves {
  position: absolute;
  top: 0;
  right: -3px;

  width: 28px;
  height: 32px;

  pointer-events: none;
}

.rc-story-leaf {
  position: absolute;

  background:
    linear-gradient(135deg,#a2b97c,#507044);

  box-shadow: 0 1px 2px rgba(48,74,57,.12);
}

.rc-story-leaf-one {
  top: 0;
  right: 1px;

  width: 15px;
  height: 23px;

  border-radius: 100% 0 100% 0;

  transform: rotate(24deg);
}

.rc-story-leaf-two {
  top: 15px;
  right: 0;

  width: 11px;
  height: 17px;

  border-radius: 0 100% 0 100%;

  transform: rotate(-7deg);
}

.rc-story-stem {
  position: absolute;
  top: 9px;
  right: 13px;

  width: 2px;
  height: 25px;

  border-radius: 999px;

  background: #637a51;

  transform: rotate(25deg);
}

.rc-unread-badge {
  position: absolute;
  z-index: 10;

  top: -6px;
  right: -6px;

  width: 22px;
  height: 22px;

  display: grid;
  place-items: center;

  border: 2px solid #fff8e9;
  border-radius: 50%;

  background: #db5943;
  color: white;

  box-shadow: 0 4px 10px rgba(100,50,40,.2);

  font-size: 10px;
  font-weight: 700;
}

/* =========================================================
   PANEL
========================================================= */

.rc-panel,
.rc-demo-panel {
  position: absolute;
  right: 0;
  bottom: 78px;

  width: 470px !important;
  height: min(650px, calc(100dvh - 120px)) !important;

  display: flex !important;
  flex-direction: column !important;

  overflow: hidden;

  border: 1px solid rgba(211,161,61,.68) !important;
  border-radius: 27px !important;

  background: #fffaf0 !important;

  box-shadow:
    0 34px 80px rgba(40,69,48,.18),
    0 10px 28px rgba(87,69,36,.10) !important;
}

/* =========================================================
   HEADER
========================================================= */

.rc-panel-header,
.rc-demo-header {
  flex: 0 0 78px !important;

  min-height: 78px !important;
  padding: 11px 18px !important;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid rgba(211,161,61,.36) !important;

  background:
    radial-gradient(circle at 76% -25%,rgba(245,207,119,.26),transparent 35%),
    #fffaf0 !important;
}

.rc-panel-brand {
  display: flex;
  align-items: center;
  gap: 11px;
}

.rc-demo-header .rc-story-symbol {
  width: 49px;
  height: 49px;
  flex: 0 0 49px;
}

.rc-panel-brand-copy {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.rc-panel-brand-copy strong {
  color: #b8872f !important;

  font-family: Aptos, "Segoe UI", Arial, sans-serif !important;
  font-size: 18px !important;
  font-weight: 700 !important;
  letter-spacing: 0 !important;
}

.rc-panel-brand-copy span {
  color: #7b857c !important;

  font-family: Aptos, "Segoe UI", Arial, sans-serif !important;
  font-size: 10.5px !important;
  letter-spacing: 0 !important;
}

.rc-panel-controls {
  display: flex;
  align-items: center;
  gap: 4px;
}

.rc-control {
  width: 32px;
  height: 32px;
  padding: 0;

  display: grid;
  place-items: center;

  border: 0;
  border-radius: 50%;

  background: transparent;
  color: #315e43;

  font-size: 15px;

  cursor: pointer;
}

.rc-control:hover {
  background: rgba(57,104,67,.08);
}

/* =========================================================
   SCROLLING BODY
========================================================= */

.rc-demo-body {
  position: relative;

  flex: 1 1 auto;
  min-height: 0;

  overflow: auto;

  background:
    linear-gradient(
      rgba(255,253,244,.22),
      rgba(255,250,235,.22)
    ),
    url("/menjadi-nol-nature.png") center / cover no-repeat;

  background-size: auto;
  background-repeat: no-repeat;
}

/* scrollbar stays visible */

.rc-demo-body-write {
  scrollbar-width: none;
}

.rc-demo-body-write::-webkit-scrollbar {
  display: none;
}
.rc-demo-body::-webkit-scrollbar {
  width: 11px;
  height: 11px;
}

.rc-demo-body::-webkit-scrollbar-track {
  background: rgba(255,250,239,.9);
}

.rc-demo-body::-webkit-scrollbar-thumb {
  border: 3px solid rgba(255,250,239,.9);
  border-radius: 999px;

  background: #a7a79f;
}

/* =========================================================
   WRITE SCREEN
========================================================= */

.rc-screen {
  position: relative;
  z-index: 1;

  min-width: 438px;
  min-height: 100%;

  padding: 27px 31px 30px;

  color: #31533d;
}

.rc-screen-heading {
  max-width: 370px;
  margin: 0 auto 18px;

  text-align: center;
}

.rc-kicker {
  display: block;

  margin-bottom: 8px;

  color: #b97920;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: .25em;
}

.rc-screen-heading h2,
.rc-list-top h2,
.rc-thread-title h2,
.rc-result-screen h2 {
  color: #24583b;

  font-family: Georgia, "Times New Roman", serif;
  font-weight: 400;
}

.rc-screen-heading h2 {
  max-width: 360px;

  margin: 0 auto 11px;

  font-size: 30px;
  line-height: 1.06;
  letter-spacing: -.018em;
}

.rc-screen-heading p,
.rc-result-screen > p {
  margin: 0;

  color: #758077;

  font-size: 11.5px;
  line-height: 1.55;
}

/* =========================================================
   JOURNAL PAPER
========================================================= */

.rc-story-input {
  width: 100%;
  min-width: 390px;
  min-height: 215px;

  padding: 18px 19px;

  resize: vertical;

  border: 1px solid rgba(86,126,75,.52);
  border-radius: 19px;
  outline: 0;

  background:
    repeating-linear-gradient(
      180deg,
      rgba(255,254,248,.96) 0,
      rgba(255,254,248,.96) 39px,
      rgba(106,126,92,.075) 40px
    );

  color: #334d39;

  box-shadow:
    0 11px 25px rgba(49,78,53,.08),
    0 0 0 5px rgba(255,250,230,.55);

  font-family: Aptos, "Segoe UI", Arial, sans-serif;
  font-size: 13px;
  line-height: 1.65;
}

.rc-story-input::placeholder {
  color: #9aa69c;
}

.rc-story-input:focus {
  border-color: #4f8154;

  box-shadow:
    0 0 0 4px rgba(76,125,79,.10),
    0 12px 27px rgba(49,78,53,.08);
}

/* =========================================================
   PRIVACY
========================================================= */

.rc-private-note {
  margin: 15px 2px 14px;
  padding: 10px 12px;

  display: flex;
  align-items: center;
  gap: 10px;

  border: 1px solid rgba(96,132,83,.18);
  border-radius: 15px;

  background: rgba(238,244,222,.84);
}

.rc-lock {
  width: 27px;
  height: 27px;
  flex: 0 0 27px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: #dceacb;
  color: #507443;

  font-size: 11px;
}

.rc-private-note p {
  margin: 0;

  color: #5c6c60;

  font-size: 9.5px;
  line-height: 1.45;
}

/* =========================================================
   CTA
========================================================= */

.rc-demo-primary {
  width: 100%;
  min-height: 48px;

  border: 1px solid #d1a148;
  border-radius: 999px;

  background:
    linear-gradient(135deg,#39714a 0%,#195335 100%);

  color: #fffdf4;

  box-shadow:
    0 0 0 3px rgba(244,205,115,.26),
    0 10px 24px rgba(32,79,48,.22);

  font-family: Georgia, "Times New Roman", serif;
  font-size: 17px;

  cursor: pointer;

  transition:
    transform .16s ease,
    box-shadow .16s ease;
}

.rc-demo-primary:hover:not(:disabled) {
  transform: translateY(-1px);

  box-shadow:
    0 0 0 3px rgba(244,205,115,.34),
    0 13px 28px rgba(32,79,48,.27);
}

.rc-demo-primary:disabled {
  opacity: .58;
  cursor: default;
}

.rc-text-button {
  display: block;

  margin: 15px auto 0;
  padding: 4px 8px;

  border: 0;

  background: transparent;
  color: #315f3d;

  font-family: Aptos, "Segoe UI", Arial, sans-serif;
  font-size: 10.5px;
  font-weight: 550;

  text-decoration: underline;
  text-decoration-color: rgba(49,95,61,.34);
  text-underline-offset: 4px;

  cursor: pointer;
}

/* =========================================================
   RESULT
========================================================= */

.rc-result-screen {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
}

.rc-result-screen h2 {
  margin: 20px 0 8px;
  font-size: 25px;
}

.rc-envelope {
  position: relative;

  width: 108px;
  height: 76px;

  border: 1px solid #d2a54c;
  border-radius: 13px;

  background: linear-gradient(145deg,#fffdf6,#f7e7bd);

  box-shadow: 0 12px 26px rgba(100,82,45,.10);
}

.rc-envelope-leaf {
  position: absolute;

  top: -15px;
  right: 15px;

  width: 18px;
  height: 30px;

  border-radius: 100% 0 100% 0;

  background: linear-gradient(135deg,#9fb779,#507145);

  transform: rotate(27deg);
}

.rc-envelope-check {
  position: absolute;

  right: -14px;
  bottom: -14px;

  width: 37px;
  height: 37px;

  display: grid;
  place-items: center;

  border: 4px solid #fffaf0;
  border-radius: 50%;

  background: #326943;
  color: white;

  font-size: 9px;
  font-weight: 700;
}

.rc-status-card {
  width: 275px;

  margin: 22px 0 18px;
  padding: 14px;

  display: flex;
  flex-direction: column;
  gap: 4px;

  border: 1px solid rgba(206,162,75,.22);
  border-radius: 15px;

  background: rgba(249,237,202,.86);
}

.rc-status-card span {
  color: #7e6c4c;
  font-size: 10px;
}

.rc-status-card strong {
  color: #31563d;
  font-size: 13px;
}

/* =========================================================
   SECONDARY BUTTON
========================================================= */

.rc-demo-secondary,
.rc-small-primary {
  font-family: Aptos, "Segoe UI", Arial, sans-serif;
  cursor: pointer;
}

.rc-demo-secondary {
  min-width: 170px;
  min-height: 42px;

  padding: 0 18px;

  border: 1px solid rgba(56,101,65,.30);
  border-radius: 999px;

  background: #fffaf0;
  color: #315f3f;

  font-size: 11px;
  font-weight: 650;
}

.rc-small-primary {
  padding: 9px 13px;

  border: 0;
  border-radius: 999px;

  background: #326842;
  color: white;

  font-size: 10px;
  font-weight: 650;
}

/* =========================================================
   STORY LIST
========================================================= */

.rc-list-top {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 14px;

  margin-bottom: 18px;
}

.rc-list-top h2 {
  max-width: 250px;

  margin: 6px 0 0;

  font-size: 22px;
  line-height: 1.15;
}

.rc-story-list {
  display: flex;
  flex-direction: column;
  gap: 9px;

  min-width: 405px;
}

.rc-story-row {
  width: 100%;

  padding: 13px;

  display: grid;
  grid-template-columns: minmax(180px,1fr) auto 18px;
  align-items: center;
  gap: 9px;

  border: 1px solid rgba(91,119,82,.18);
  border-radius: 14px;

  background: rgba(255,253,247,.94);

  text-align: left;

  cursor: pointer;
}

.rc-story-row-copy {
  min-width: 0;

  display: flex;
  flex-direction: column;
  gap: 4px;
}

.rc-story-row-copy strong {
  overflow: hidden;

  color: #304c38;

  font-size: 12px;
  font-weight: 650;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.rc-story-row-copy small {
  color: #858b82;
  font-size: 9px;
}

.rc-status {
  padding: 5px 8px;

  border-radius: 999px;

  font-size: 8.5px;
  white-space: nowrap;
}

.rc-status-new {
  background: #f9ddd4;
  color: #a64c39;
}

.rc-status-read {
  background: #e1edf5;
  color: #456f8c;
}

.rc-status-wait {
  background: #f7e9bd;
  color: #866720;
}

.rc-status-done {
  background: #dfeede;
  color: #4c7552;
}

.rc-row-arrow {
  color: #536d57;
  font-size: 16px;
}

/* =========================================================
   THREAD
========================================================= */

.rc-back {
  margin: 0 0 15px;
  padding: 0;

  border: 0;

  background: transparent;
  color: #496b50;

  font-size: 10px;

  cursor: pointer;
}

.rc-thread-title {
  margin-bottom: 18px;
  text-align: center;
}

.rc-thread-title h2 {
  margin: 0 0 4px;
  font-size: 24px;
}

.rc-thread-title span {
  color: #898d85;
  font-size: 9px;
}

.rc-thread-line {
  position: relative;

  display: flex;
  flex-direction: column;
  gap: 12px;

  margin-bottom: 18px;
  padding-left: 22px;
}

.rc-thread-line::before {
  content: "";

  position: absolute;

  top: 10px;
  bottom: 10px;
  left: 7px;

  width: 1px;

  background: rgba(183,153,92,.34);
}

.rc-letter {
  padding: 14px 15px;

  border-radius: 14px;
}

.rc-letter-user {
  background: rgba(249,237,214,.94);
}

.rc-letter-admin {
  background: rgba(229,239,220,.95);
}

.rc-letter-label {
  display: block;

  margin-bottom: 4px;

  color: #304b38;

  font-size: 12px;
  font-weight: 700;
}

.rc-letter time {
  display: block;

  margin-bottom: 9px;

  color: #8a8d84;

  font-size: 8.5px;
}

.rc-letter p {
  margin: 0;

  color: #48564a;

  font-size: 11.5px;
  line-height: 1.6;
}

.rc-thread-leaf {
  position: relative;
  z-index: 2;

  width: 17px;
  height: 17px;

  margin-left: -23px;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background: #edf2e5;
  color: #668057;

  font-size: 11px;
}

.rc-left-heading {
  margin-left: 0;
  text-align: left;
}

/* old CSS botanical not used */

.rc-botanical {
  display: none !important;
}

/* =========================================================
   FOOTER
========================================================= */

.rc-demo-footer {
  flex: 0 0 43px;

  min-height: 43px;
  padding: 8px 17px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  border-top: 1px solid rgba(211,161,61,.30);

  background: #fff9eb;
}

.rc-demo-footer span {
  color: #aa701d;

  font-size: 8px;
  font-weight: 800;
  letter-spacing: .18em;
}

.rc-demo-footer small {
  color: #858b82;
  font-size: 8px;
}

/* =========================================================
   MOBILE
========================================================= */

@media (max-width:600px) {
  .rc-widget {
    right: 90px;
    bottom: 14px;
  }

  .rc-panel,
  .rc-demo-panel {
    position: fixed;

    left: 10px;
    right: 10px;
    bottom: 82px;

    width: auto !important;
    height: min(650px,calc(100dvh - 105px)) !important;

    border-radius: 23px !important;
  }

  .rc-launch {
    width: 58px;
    height: 58px;
  }

  .rc-launch-label {
    display: none;
  }

  .rc-screen {
    padding: 24px 22px 27px;
  }
}

/* Horizontal scrolling is intentionally preserved. */

@media (prefers-reduced-motion:reduce) {
  .rc-launch,
  .rc-demo-primary {
    transition: none;
  }
}






