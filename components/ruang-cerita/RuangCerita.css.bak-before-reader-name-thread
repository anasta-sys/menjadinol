/* ============================================================
   RUANG CERITA - FINAL READER BOTANICAL THREAD
   ============================================================ */

/* RIWAYAT CERITA - dibuat jelas dan mudah diklik */
.rc-history-link,
.rc-history-button {
  min-height: 38px !important;
  padding: 0 18px !important;
  border: 1px solid rgba(23, 77, 56, .28) !important;
  border-radius: 999px !important;
  background: rgba(255, 253, 247, .88) !important;
  color: #174d38 !important;
  font-family: Aptos, "Segoe UI", Arial, sans-serif !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  line-height: 1.2 !important;
  text-decoration: none !important;
  box-shadow: 0 5px 15px rgba(23, 77, 56, .06) !important;
  opacity: 1 !important;
  cursor: pointer !important;
  transition:
    background 160ms ease,
    border-color 160ms ease,
    transform 160ms ease,
    box-shadow 160ms ease !important;
}

.rc-history-link:hover,
.rc-history-button:hover {
  border-color: #174d38 !important;
  background: #f4f8ef !important;
  box-shadow: 0 7px 18px rgba(23, 77, 56, .10) !important;
  transform: translateY(-1px);
}

/* fallback untuk tombol/link riwayat yang sekarang */
.rc-panel button:not(.rc-launch):not(.rc-close):not(.rc-minimize) {
  opacity: 1;
}

/* THREAD */
.rc-thread {
  position: relative !important;
}

/* Semua kartu pesan */
.rc-message {
  position: relative !important;
  overflow: hidden !important;
  border-radius: 19px !important;
  box-shadow: 0 6px 18px rgba(52, 67, 52, .055) !important;
}

/* CERITA READER - warm cream/gold */
.rc-message-reader,
.rc-message.user,
.rc-message.reader {
  border: 1px solid rgba(185, 146, 55, .24) !important;
  background:
    linear-gradient(
      120deg,
      rgba(255, 251, 238, .97),
      rgba(250, 244, 225, .90)
    ) !important;
  color: #30483a !important;
}

/* aksen emas di kiri cerita */
.rc-message-reader::before,
.rc-message.user::before,
.rc-message.reader::before {
  content: "" !important;
  position: absolute !important;
